# Codex also reads <repo>/.agents/skills. This metadata keeps Codex from ever
# invoking this Antigravity-lead skill on its own; Antigravity ignores the file.
# Do not add keys beyond the verified fields below.
interface:
  display_name: "Cross-LLM Delivery for Antigravity leads ({{PROVIDER_NAME}} executor)"
  short_description: "Antigravity-lead variant. Codex leads use cross-llm-{{PROVIDER_NAME}} instead."
  default_prompt: "Use cross-llm-{{PROVIDER_NAME}} instead: this skill is written for an Antigravity lead."
policy:
  products: [CODEX]
  allow_implicit_invocation: false
